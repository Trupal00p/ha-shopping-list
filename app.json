{
  "expo": {
    "name": "HA Shopping List",
    "slug": "hashopping3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "list",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trupal00p.hashoppinglist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.trupal00p.hashoppinglist"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-build-properties",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ef38eddc-fe05-4826-adfd-7b8d661da2e7"
      }
    }
  }
}
